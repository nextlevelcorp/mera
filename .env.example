# Variable names only. Never put values here; the real .env is gitignored.
# The game itself reads no environment variables: anything in the web export is public.

# Godot release used by CI and the cloud setup script, e.g. 4.4.1-stable.
# Source of truth is the .godot-version file; this name is for local tooling.
GODOT_VERSION=

# Firecrawl API key for the firecrawl MCP server in .mcp.json (web scraping and docs lookup by the
# coding agent; never used by the game). Set it in your shell or the cloud environment's secrets.
FIRECRAWL_API_KEY=
